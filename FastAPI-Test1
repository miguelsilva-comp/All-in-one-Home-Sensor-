from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import random
from datetime import datetime

# (FASTAPI) - This is the core of our backend, handling incoming requests and sending responses.
app = FastAPI(title="All-in-One Home Monitoring System API")

# SECURITY - Cross-Origin Resource Sharing settings to allow our frontend to communicate with this backend without issues.
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"], 
    allow_methods=["*"],
    allow_headers=["*"],
)

# DATA RULES - This defines the structure of the data we expect to receive from the hardware team. 
# It ensures that we get numbers for our sensor readings, not text or other invalid data.
class SensorReading(BaseModel):
    temperature: float
    humidity: float
    pressure: float
    nitrogen_dioxide: float
    ammonia: float
    timestamp: str

# LOGIN- This is a simple login endpoint to demonstrate how we can handle user authentication.
@app.post("/login")
async def login(username: str, password: str):
    # Hardcoded user for the "Begin Development" demo
    if username == "admin" and password == "password123":
        return {"message": "Login successful", "token": "fake-jwt-token-for-demo"}
    raise HTTPException(status_code=401, detail="Invalid credentials")

# GET DATA - This endpoint allows the frontend to retrieve the latest sensor readings.
@app.get("/status", response_model=SensorReading)
async def get_status():
    # Generating test data to simulate real sensor readings. In a real application, this would come from the components that we have used.
    reading = {
        "temperature": round(random.uniform(20.0, 25.0), 2),
        "humidity": round(random.uniform(40.0, 60.0), 2),
        "pressure": 1013.25,
        "nitrogen_dioxide": round(random.uniform(0.01, 0.04), 4),
        "ammonia": round(random.uniform(0.1, 0.3), 3),
        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    }
    return reading

# START SERVER
if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
